{
  "name": "portail-habitat",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev emulateurs",
    "emulateurs": "firebase emulators:start --project demo-portail-habitat --import=.emulateurs --export-on-exit",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "firebase emulators:exec --project demo-portail-habitat --only auth,firestore,storage \"turbo run test\"",
    "test:unit": "turbo run test --filter=!@ph/firebase",
    "e2e": "turbo run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "firebase-tools": "^15.31.0",
    "globals": "^17.12.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
