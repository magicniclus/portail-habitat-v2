  "diagnostics": [
    {
      "id": "dpe",
      "nom": "DPE (performance énergétique)",
      "prix": [
        110,
        190
      ],
      "val": 10,
      "req": {
        "$formule": "(c) => c.motif !== \"travaux\""
      },
      "quand": "Obligatoire pour toute vente et toute mise en location",
      "validite": "10 ans",
      "note": "Un DPE établi avant le 1er juillet 2021 n'est plus valable."
    },
