# Copier en .env.local (jamais commité). Les secrets de production vivent dans Vercel et Secret Manager.
# Détail : docs/INTEGRATIONS.md §8, docs/EMAILS.md §9, docs/AVANCEMENT.md §4.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# App Check n'a pas d'émulateur : « desactive » en local uniquement (refusé en production).
APP_CHECK_MODE=desactive

# --- Firebase (lot 1) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=portail-habitat-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Sentry (lot 1) : inactif si vide ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- INSEE (lot 4) ---
INSEE_API_KEY=

# --- Emails et SMS (lot 5) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Portail Habitat <notifications@portailhabitat.fr>"
EMAIL_FROM_PRO="Portail Habitat Pro <pro@notifications.portailhabitat.fr>"
EMAIL_FROM_HUMAIN="Julie de Portail Habitat Pro <julie@notifications.portailhabitat.fr>"
EMAIL_REPLY_TO=support@portailhabitat.fr
EMAIL_REPLY_TO_COMMERCIAL=julie@portailhabitat.fr
EMAIL_CAPTURE=mailpit
EMAIL_WHITELIST=@portailhabitat.fr
NOTIF_SIGNING_SECRET=
BREVO_API_KEY=
SMS_SENDER=PortailHab

# --- Recherche (lot 7) ---
TYPESENSE_HOST=
TYPESENSE_ADMIN_KEY=
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=

# --- Stripe (lot 11) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PREMIUM_MENSUEL=
STRIPE_PRICE_PREMIUM_ANNUEL=
STRIPE_PRICE_VISIBILITE_MENSUEL=
STRIPE_PRICE_VISIBILITE_ANNUEL=
STRIPE_PRICE_SIEGE=
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_PACK_25=
STRIPE_PRICE_PACK_50=

# --- Partenaires (lot 12b), comportement et IA (lot 13c) : Secret Manager ---
PARTENAIRE_API_KEYS=
REPLAYS_BUCKET=portailhabitat-replays
COMPORTEMENT_SALT_SECRET=
ANTHROPIC_API_KEY=
